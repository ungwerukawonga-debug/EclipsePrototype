    private void ToggleComments(ChatMsg msg)
    {
        msg.ShowCommentsPanel = !msg.ShowCommentsPanel;
    }

    private void AddEmojiReaction(ChatMsg msg, string emoji)
    {
        msg.ShowReactionsPanel = false;
        var existing = msg.Reactions.FirstOrDefault(r => r.Emoji == emoji);
        
        if (existing != null)
        {
            if (existing.UserReacted)
            {
                existing.Count--;
                existing.UserReacted = false;
            }
            else
            {
                existing.Count++;
                existing.UserReacted = true;
            }
        }
        else
        {
            msg.Reactions.Add(new ReactionItem {
                Emoji = emoji,
                Count = 1,
                UserReacted = true
            });
        }
    }

    private void ToggleReaction(ChatMsg msg, string emoji)
    {
        var existing = msg.Reactions.FirstOrDefault(r => r.Emoji == emoji);
        if (existing != null)
        {
            if (existing.UserReacted)
            {
                existing.Count--;
                existing.UserReacted = false;
            }
            else
            {
                existing.Count++;
                existing.UserReacted = true;
            }
        }
    }

