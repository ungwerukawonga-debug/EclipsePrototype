@page "/guardian-creation"
@layout AuthLayout

<style>
    .neon-glow-primary {
      box-shadow: 0 0 20px rgba(255, 210, 63, 0.2);
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #131313;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #4d4634;
      border-radius: 10px;
    }
</style>

<!-- Top Navigation Shell -->
<header class="fixed top-0 w-full z-50 flex justify-between items-center px-6 h-16 bg-[#131313] dark:bg-[#131313]">
    <div class="flex items-center gap-2">
        <span class="text-2xl font-black tracking-tighter text-[#FFD23F] drop-shadow-[0_0_10px_rgba(255,210,63,0.3)] font-headline">eQCLIPSE</span>
    </div>
    <div class="flex items-center gap-4">
        <div class="w-8 h-8 rounded-full bg-surface-container-highest flex items-center justify-center border border-outline-variant/30">
            <span class="material-symbols-outlined text-primary text-sm">shield</span>
        </div>
    </div>
</header>

<main class="min-h-screen pt-20 pb-12 px-6 max-w-5xl mx-auto flex flex-col items-center">
    <!-- Hero Header -->
    <section class="text-center mb-10 w-full">
        <h1 class="font-headline text-4xl md:text-6xl font-black tracking-tighter uppercase mb-2 text-on-background">
            Wellness <span class="text-primary-container">Support</span>
        </h1>
        <p class="text-on-surface-variant font-medium tracking-wide max-w-lg mx-auto">
            Set up your profile and connect with licensed therapists when you need someone to talk to.
        </p>
    </section>

    <!-- Bento Grid Layout -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 w-full items-start">
        <!-- Character Preview: Large Central Feature -->
        <div class="md:col-span-7 lg:col-span-8 h-[500px] md:h-[700px] rounded-3xl bg-surface-container-lowest relative overflow-hidden flex items-center justify-center border border-primary-container/10 group">
            <div class="absolute inset-0 bg-gradient-to-t @(selectedAffinity == "Aeroblaze" ? "from-primary-container/10" : selectedAffinity == "AquaticShock" ? "from-tertiary-container/10" : selectedAffinity == "BioBuilder" ? "from-emerald-500/10" : selectedAffinity == "Divine-Nchant" ? "from-fuchsia-500/10" : "from-surface-variant/20") to-transparent pointer-events-none transition-colors duration-500"></div>
            <!-- Silhouette / Figure Area -->
            <div class="relative w-full h-full flex items-center justify-center transition-all duration-500 @(string.IsNullOrEmpty(selectedAffinity) ? "opacity-50 grayscale" : "opacity-100 grayscale-0")">
                <div class="absolute w-[300px] h-[300px] rounded-full blur-[100px] animate-pulse transition-colors duration-500 @(selectedAffinity == "Aeroblaze" ? "bg-primary-container/10" : selectedAffinity == "AquaticShock" ? "bg-tertiary-container/10" : selectedAffinity == "BioBuilder" ? "bg-emerald-500/10" : selectedAffinity == "Divine-Nchant" ? "bg-fuchsia-500/10" : "bg-outline/5")"></div>
                
                @if(selectedGenetic == "Feminine") {
                    <img alt="Guardian Preview" class="h-full w-auto object-contain z-10 transition-all duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDTB4K6kO4rUOhA0aYnF0zFvA4XEX7cKqB-dOaQ6I2dM7hX5N3yD_rO0tKxO2xQzZtA2hB1b5G_fFjXwH4M3aU9vZy4v5P2gR8M1Lg_sD1Hh6mE-pC5-B9w_VzI8vXGkM7YcT6zY8E4A0aT3u" />
                } else if(selectedGenetic == "Neutral") {
                    <img alt="Guardian Preview" class="h-[90%] w-auto object-contain z-10 transition-all duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDlQvF1a3mQZ55tG9tW0xT0N2xS2Z8N_xV1n_tV-F6_C7HwH2D9n3uUu1P9GvRj_wR7t4K3I2O5J8pX_r6t4_N22s-Q2M0X4qK3Y3_5V1_m3R1T8L8bFz1M7Y5zZ0J7hT7eX_Vz8Y9Y9xY7b2M_x2T1_" />
                } else {
                    <img alt="Guardian Preview" class="h-full w-auto object-contain z-10 drop-shadow-[0_0_30px_rgba(255,210,63,0.4)] transition-all duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCzWibzho-PJcoG3w2ESNfTbvaNYJqJ-fgu86uUBs8E3qou9vWA6Rb8yfvUjzBGbyr-Iz2L0RiLCFEKWTSNeKZYEAksHk2oZUXPpRnq4bR-sAgRRScQsdestqp-4UUCFounhHDM2E3JgeAm_Bsk6_8LRHPKRnHfmxfYuG0UrtFL9LibGfLGSr0N_U8LAsBJ_iL7LU56wyRd42FTq4oecujSLKJ3aIk6aZjvZV-ePNe1HCgKpCAtmeWe9ckLSdO0hhaxgUH13qXjKQc"/>
                }
            </div>
            <!-- Float Stats -->
            <div class="absolute bottom-6 left-6 right-6 flex justify-between items-end backdrop-blur-md bg-surface-container/40 p-6 rounded-2xl border border-outline-variant/20">
                <div>
                    <span class="text-[10px] uppercase tracking-[0.2em] text-primary-container font-bold block mb-1">Status</span>
                    @if(string.IsNullOrEmpty(guardianName)) {
                        <span class="text-xl font-headline font-bold text-on-background">NOT SET</span>
                    } else {
                        <span class="text-xl font-headline font-bold text-on-background">@guardianName</span>
                    }
                </div>
                <div class="flex flex-col items-end">
                    <span class="text-[10px] uppercase tracking-[0.2em] text-on-surface-variant font-medium block mb-1">Profile</span>
                    <span class="text-xl font-headline font-bold text-primary-container">80%</span>
                </div>
            </div>
        </div>

        <!-- Selection Controls: Right Side Panel -->
        <div class="md:col-span-5 lg:col-span-4 flex flex-col gap-6">
            <!-- Gender Selection -->
            <div class="p-6 bg-surface-container rounded-3xl border border-outline-variant/10">
                <label class="text-[10px] uppercase tracking-[0.2em] text-on-surface-variant font-bold block mb-4">Presentation</label>
                <div class="flex p-1 bg-surface-container-lowest rounded-2xl gap-1">
                    <button class="flex-1 py-3 rounded-xl transition-all text-sm @(selectedGenetic == "Masculine" ? "bg-surface-container-highest text-primary-container font-bold shadow-lg" : "text-on-surface-variant hover:bg-surface-variant font-medium")" @onclick="@(() => SetGenetic("Masculine"))">Masculine</button>
                    <button class="flex-1 py-3 rounded-xl transition-all text-sm @(selectedGenetic == "Feminine" ? "bg-surface-container-highest text-primary-container font-bold shadow-lg" : "text-on-surface-variant hover:bg-surface-variant font-medium")" @onclick="@(() => SetGenetic("Feminine"))">Feminine</button>
                    <button class="flex-1 py-3 rounded-xl transition-all text-sm @(selectedGenetic == "Neutral" ? "bg-surface-container-highest text-primary-container font-bold shadow-lg" : "text-on-surface-variant hover:bg-surface-variant font-medium")" @onclick="@(() => SetGenetic("Neutral"))">Neutral</button>
                </div>
            </div>

            <!-- Ability Selection -->
            <div class="space-y-4">
                <label class="text-[10px] uppercase tracking-[0.2em] text-on-surface-variant font-bold block">Wellness Style</label>
                <div class="grid grid-cols-2 gap-3">
                    <button class="p-4 rounded-2xl flex flex-col items-start gap-3 text-left transition-all @(selectedAffinity == "Aeroblaze" ? "bg-surface-container border border-primary-container/30 ring-2 ring-primary-container/20 scale-[1.02]" : "bg-surface-container-low border border-outline-variant/10 hover:bg-surface-container-highest")" @onclick="@(() => SetAffinity("Aeroblaze"))">
                        <div class="w-10 h-10 rounded-xl flex items-center justify-center transition-colors @(selectedAffinity == "Aeroblaze" ? "bg-primary-container/20 text-primary-container shadow-[0_0_10px_rgba(255,210,63,0.3)]" : "bg-primary-container/5 text-primary-container/50")">
                            <span class="material-symbols-outlined">cyclone</span>
                        </div>
                        <div>
                            <span class="block text-sm font-bold text-primary-container">Energized</span>
                            <span class="text-[10px] text-on-surface-variant">Motivation & action</span>
                        </div>
                    </button>
                    <button class="p-4 rounded-2xl flex flex-col items-start gap-3 text-left transition-all @(selectedAffinity == "AquaticShock" ? "bg-surface-container border border-tertiary-container/30 ring-2 ring-tertiary-container/20 scale-[1.02]" : "bg-surface-container-low border border-outline-variant/10 hover:bg-surface-container-highest")" @onclick="@(() => SetAffinity("AquaticShock"))">
                        <div class="w-10 h-10 rounded-xl flex items-center justify-center transition-colors @(selectedAffinity == "AquaticShock" ? "bg-tertiary-container/20 text-tertiary-container shadow-[0_0_10px_rgba(47,236,253,0.3)]" : "bg-tertiary-container/5 text-tertiary-container/50")">
                            <span class="material-symbols-outlined">bolt</span>
                        </div>
                        <div>
                            <span class="block text-sm font-bold text-on-background">Reflective</span>
                            <span class="text-[10px] text-on-surface-variant">Calm & clarity</span>
                        </div>
                    </button>
                    <button class="p-4 rounded-2xl flex flex-col items-start gap-3 text-left transition-all @(selectedAffinity == "BioBuilder" ? "bg-surface-container border border-emerald-500/30 ring-2 ring-emerald-500/20 scale-[1.02]" : "bg-surface-container-low border border-outline-variant/10 hover:bg-surface-container-highest")" @onclick="@(() => SetAffinity("BioBuilder"))">
                        <div class="w-10 h-10 rounded-xl flex items-center justify-center transition-colors @(selectedAffinity == "BioBuilder" ? "bg-emerald-500/20 text-emerald-400 shadow-[0_0_10px_rgba(52,211,153,0.3)]" : "bg-emerald-500/5 text-emerald-400/50")">
                            <span class="material-symbols-outlined">eco</span>
                        </div>
                        <div>
                            <span class="block text-sm font-bold text-on-background">Grounded</span>
                            <span class="text-[10px] text-on-surface-variant">Growth & balance</span>
                        </div>
                    </button>
                    <button class="p-4 rounded-2xl flex flex-col items-start gap-3 text-left transition-all @(selectedAffinity == "Divine-Nchant" ? "bg-surface-container border border-fuchsia-400/30 ring-2 ring-fuchsia-400/20 scale-[1.02]" : "bg-surface-container-low border border-outline-variant/10 hover:bg-surface-container-highest")" @onclick="@(() => SetAffinity("Divine-Nchant"))">
                        <div class="w-10 h-10 rounded-xl flex items-center justify-center transition-colors @(selectedAffinity == "Divine-Nchant" ? "bg-fuchsia-500/20 text-fuchsia-400 shadow-[0_0_10px_rgba(232,121,249,0.3)]" : "bg-fuchsia-500/5 text-fuchsia-400/50")">
                            <span class="material-symbols-outlined">auto_fix_high</span>
                        </div>
                        <div>
                            <span class="block text-sm font-bold text-on-background">Creative</span>
                            <span class="text-[10px] text-on-surface-variant">Expression & joy</span>
                        </div>
                    </button>
                </div>
            </div>

            <!-- Name Input Field -->
            <div class="p-6 bg-surface-container rounded-3xl border border-outline-variant/10">
                <label class="text-[10px] uppercase tracking-[0.2em] text-on-surface-variant font-bold block mb-3">Display Name</label>
                <div class="relative">
                    <input @bind="guardianName" @bind:event="oninput" class="w-full bg-surface-container-highest border-none rounded-2xl py-4 px-5 text-on-background focus:ring-1 focus:ring-primary-container placeholder:text-on-surface-variant/40 font-bold outline-none" placeholder="How should we address you?" type="text" />
                    <span class="absolute right-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-primary-container/40">fingerprint</span>
                </div>
            </div>

            <!-- Validation Error Msg -->
            @if(showError) {
                <p class="text-error text-xs font-bold text-center mt-[-10px] mb-[-10px]">Please select a wellness style and enter your name.</p>
            }

            <!-- Confirm Button -->
            <button class="w-full py-6 bg-primary-container text-on-primary font-headline font-black text-lg rounded-3xl shadow-[0_15px_30px_rgba(255,210,63,0.2)] transition-all active:scale-95 hover:bg-primary-fixed-dim uppercase tracking-tighter disabled:opacity-50 flex items-center justify-center gap-2" @onclick="HandleInitialization" disabled="@isLoading">
                @if(isLoading) {
                    <span class="material-symbols-outlined animate-spin text-xl">sync</span>
                    <span>Setting up profile...</span>
                } else {
                    <span>Complete Setup</span>
                }
            </button>
        </div>
    </div>
</main>

<div class="fixed inset-0 pointer-events-none z-[-1] overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBhCW6iXnnjojGvVaJupm2vBzQOcMFrAQiFhgfJCnZ6o_c9DCOSWhKRoLA4WJtCVMGVAAz5zS3XHxO4up_vaeXLmsglljyhZuKqhPwQRoRBW12XAHFa_cSbzo5hX-2fcTGGJsrcNeZJcJhA332TfN9KNYNetNsX-daC-4Ko8GjrhyY1DOZCMFFkuciWAFmq_XkMP9G9CFCVe4Ho8R2IVA4ZY726kSYOXwL8BWPhs2en05jkhuah6K3Anq95QaJMSIRVjABDK-Mnd1c');"></div>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private string selectedGenetic = "Masculine";
    private string selectedAffinity = "";
    private string guardianName = "";
    
    private bool isLoading = false;
    private bool showError = false;

    private void SetGenetic(string profile)
    {
        selectedGenetic = profile;
    }

    private void SetAffinity(string affinity)
    {
        selectedAffinity = affinity;
        showError = false;
    }

    private async Task HandleInitialization()
    {
        if (string.IsNullOrWhiteSpace(guardianName) || string.IsNullOrEmpty(selectedAffinity))
        {
            showError = true;
            return;
        }
        
        showError = false;
        isLoading = true;
        StateHasChanged();
        
        await Task.Delay(1800); // Wait for the mock creation process
        
        Navigation.NavigateTo("aether-horizon");
    }
}
