@page "/"
@layout AuthLayout

<!-- Decorative Background Elements -->
<div class="fixed top-0 left-0 w-full h-full pointer-events-none z-0 overflow-hidden">
    <div class="absolute top-[10%] right-[-5%] w-[40vw] h-[40vw] rounded-full bg-primary-container/5 blur-[120px]"></div>
    <div class="absolute bottom-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-tertiary-container/5 blur-[150px]"></div>
    <!-- Abstract Grid Texture (Visual only) -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: radial-gradient(#FFD23F 0.5px, transparent 0.5px); background-size: 32px 32px;"></div>
</div>

<div class="relative z-10 flex flex-col flex-grow">
    <header class="w-full flex justify-center items-center pt-12">
        <h1 class="text-3xl font-black tracking-tighter text-primary-container text-glow font-headline">eQCLIPSE</h1>
    </header>

    <main class="flex-grow flex items-center justify-center px-6 py-12">
        <div class="w-full max-w-md">
            <!-- Hero Visual / Asymmetric Element -->
            <div class="relative mb-12">
                <div class="absolute -top-12 -left-8 w-32 h-32 bg-primary-container/10 rounded-full blur-3xl"></div>
                <div class="relative z-10 text-center md:text-left">
                    <p class="font-headline font-bold text-primary-container tracking-widest uppercase text-[10px] mb-2">Sign in to eQCLIPSE</p>
                    <h2 class="font-headline font-black text-4xl md:text-5xl text-on-background tracking-tighter leading-none mb-4">
                        Welcome <span class="text-primary-container">Back</span>
                    </h2>
                </div>
            </div>

            <!-- Login Form Card -->
            <div class="glass-effect p-8 rounded-xl neon-glow border border-outline-variant/10">
                <form class="space-y-6">
                    <!-- Identity Input Group -->
                    <div class="space-y-2">
                        <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-on-surface-variant px-1">Email or Phone</label>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-sm">person</span>
                            <input @bind="IdentityNode" class="w-full bg-surface-container-highest border-none rounded-xl py-4 pl-12 pr-4 text-on-surface placeholder:text-outline/50 focus:ring-1 focus:ring-primary-fixed-dim transition-all outline-none" placeholder="Enter email or phone" type="text" />
                        </div>
                    </div>

                    <!-- Password Input Group -->
                    <div class="space-y-2">
                        <div class="flex justify-between items-end px-1">
                            <label class="block text-[10px] font-bold uppercase tracking-[0.2em] text-on-surface-variant">Password</label>
                            <a class="text-[10px] font-bold uppercase tracking-widest text-primary-container hover:text-primary transition-colors" href="#">Forgot password?</a>
                        </div>
                        <div class="relative group">
                            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline text-sm">lock</span>
                            <input @bind="AccessCipher" class="w-full bg-surface-container-highest border-none rounded-xl py-4 pl-12 pr-4 text-on-surface placeholder:text-outline/50 focus:ring-1 focus:ring-primary-fixed-dim transition-all outline-none" placeholder="••••••••" type="password" />
                            <span class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-outline text-sm cursor-pointer hover:text-primary-container transition-colors">visibility</span>
                        </div>
                    </div>

                    <!-- Primary Action -->
                    <div class="pt-4">
                        <button class="w-full bg-primary-container hover:bg-primary-fixed-dim text-on-primary font-headline font-extrabold py-4 rounded-xl shadow-[0_4px_20px_rgba(255,210,63,0.3)] active:scale-[0.98] transition-all flex items-center justify-center gap-2 disabled:opacity-50" type="button" @onclick="HandleLogin" disabled="@isLoading">
                            @if(isLoading) {
                                <span class="material-symbols-outlined text-xl animate-spin">sync</span>
                                <span>Signing in...</span>
                            } else {
                                <span>Sign In</span>
                                <span class="material-symbols-outlined text-xl">login</span>
                            }
                        </button>
                    </div>
                </form>

                <!-- Social/Quick Access Layer -->
                <div class="mt-10 flex flex-col items-center gap-6">
                    <div class="flex items-center gap-4 w-full">
                        <div class="h-[1px] flex-grow bg-outline-variant/20"></div>
                        <span class="text-[10px] font-bold uppercase tracking-widest text-outline">or connect via</span>
                        <div class="h-[1px] flex-grow bg-outline-variant/20"></div>
                    </div>

                    <div class="flex gap-4">
                        <button class="w-14 h-14 rounded-xl bg-surface-container-low flex items-center justify-center hover:bg-surface-container-highest transition-colors border border-outline-variant/10 group">
                            <div class="w-6 h-6 bg-on-surface/10 rounded-full group-hover:bg-primary-container/20 transition-colors flex items-center justify-center">
                                <span class="material-symbols-outlined text-lg">fingerprint</span>
                            </div>
                        </button>
                        <button class="w-14 h-14 rounded-xl bg-surface-container-low flex items-center justify-center hover:bg-surface-container-highest transition-colors border border-outline-variant/10 group">
                            <div class="w-6 h-6 bg-on-surface/10 rounded-full group-hover:bg-tertiary-container/20 transition-colors flex items-center justify-center">
                                <span class="material-symbols-outlined text-lg">face</span>
                            </div>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Secondary Action -->
            <div class="mt-12 text-center">
                <p class="text-on-surface-variant text-sm font-medium">
                    New here? 
                    <a class="text-primary-container font-bold ml-1 hover:underline underline-offset-4 decoration-primary-container/30" href="registration">Create Account</a>
                </p>
            </div>
        </div>
    </main>

    <!-- Visual Footer Accent -->
    <footer class="py-8 flex flex-col items-center gap-2 opacity-30 mt-auto">
        <div class="flex gap-8 mb-4">
            <span class="material-symbols-outlined text-primary-container text-xs">adjust</span>
            <span class="material-symbols-outlined text-primary-container text-xs">adjust</span>
            <span class="material-symbols-outlined text-primary-container text-xs">adjust</span>
        </div>
        <p class="text-[10px] font-bold uppercase tracking-[0.3em] text-on-surface">eQCLIPSE · Connect with care</p>
    </footer>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private string IdentityNode = "";
    private string AccessCipher = "";
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;
        StateHasChanged();
        
        await Task.Delay(1200); // Simulate network connection sync
        
        Navigation.NavigateTo("aether-horizon");
    }
}
