        }
    };

    private ContactInfo? selectedContact = null;

    private void NavigateToChat()
    {
        Navigation.NavigateTo("chat");
    }

    private void NavigateToBattery()
    {
        Navigation.NavigateTo("dm/social-battery-indicator");
    }

    private void OpenStatusModal(ContactInfo contact)
    {
        selectedContact = contact;
    }

    private void CloseStatusModal()
    {
        selectedContact = null;
    }

    private void RouteToContactChat(ContactInfo contact)
    {
        selectedContact = null;
        Navigation.NavigateTo("chat");
    }
}

