@page "/dm/story-status-feature"

<div class="relative z-10 flex flex-col flex-grow">
    <main class="flex-grow flex flex-col items-center justify-start px-6 py-8 mt-16 max-w-4xl mx-auto w-full">
        <!-- Page Header -->
        <div class="w-full text-center md:text-left mb-8">
            <h2 class="font-headline font-black text-4xl text-on-background tracking-tighter leading-none">
                Story & <span class="text-primary-container">Status</span>
            </h2>
            <p class="text-on-surface-variant text-lg mt-2">Share your moments and updates with the Aether Horizon.</p>
        </div>

        <!-- New Story/Status Section -->
        <div class="w-full glass-effect border border-outline-variant/10 rounded-3xl p-6 mb-6">
            <h3 class="text-on-surface font-headline font-bold text-xl mb-4">Create New Post</h3>
            <textarea @bind="newStatusText" placeholder="What's on your mind, Guardian?" class="w-full bg-surface-container-highest border-none rounded-xl py-3 px-4 text-on-surface placeholder:text-outline/50 focus:ring-1 focus:ring-primary-fixed-dim transition-all outline-none h-24 mb-4"></textarea>
            <div class="flex items-center gap-3 mb-4">
                <button class="bg-surface-container-highest hover:bg-surface-container-high text-on-surface font-body font-medium py-3 px-6 rounded-xl transition-colors flex items-center justify-center gap-2">
                    <span class="material-symbols-outlined text-xl">add_photo_alternate</span> Add Image (Simulated)
                </button>
                <span class="text-on-surface-variant text-sm">No file chosen</span>
            </div>
            <button @onclick="PostStatus" class="w-full bg-primary-container hover:bg-primary-fixed-dim text-on-primary font-headline font-extrabold py-3 px-6 rounded-xl shadow-[0_4px_20px_rgba(255,210,63,0.3)] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-xl">send</span> Post to Horizon
            </button>
        </div>

        <!-- Simulated Feed Section -->
        <div class="w-full glass-effect border border-outline-variant/10 rounded-3xl p-6">
            <h3 class="text-on-surface font-headline font-bold text-xl mb-4">Aether Feed</h3>
            <div class="flex flex-col gap-6">
                @if (posts.Any())
                {
                    @foreach (var post in posts)
                    {
                        <div class="bg-surface-container-highest p-4 rounded-2xl">
                            <div class="flex items-center gap-3 mb-3">
                                <span class="material-symbols-outlined text-primary-container">account_circle</span>
                                <p class="font-body text-sm text-on-surface font-medium">Guardian @post.Author</p>
                                <p class="text-on-surface-variant text-xs ml-auto">@post.Timestamp.ToShortTimeString()</p>
                            </div>
                            <p class="font-body text-sm text-on-surface">@post.Text</p>
                            @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                            {
                                <img src="@post.ImageUrl" alt="Post Image" class="mt-3 rounded-lg w-full h-48 object-cover" />
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-on-surface-variant text-sm">No recent posts. Share your first update!</p>
                }
            </div>
        </div>
    </main>
</div>

@code {
    private string newStatusText = "";
    private List<StatusPost> posts = new List<StatusPost>
    {
        new StatusPost { Author = "AetherWeaver", Text = "Just completed a deep meditation session. Feeling incredibly aligned with the Aether today! ✨", Timestamp = DateTime.Now.AddHours(-1) },
        new StatusPost { Author = "StarGazer", Text = "The celestial alignment tonight is breathtaking. Sending good vibes to all Guardians!", Timestamp = DateTime.Now.AddHours(-3), ImageUrl = "https://via.placeholder.com/400x200?text=Celestial+View" }
    };

    private void PostStatus()
    {
        if (!string.IsNullOrWhiteSpace(newStatusText))
        {
            posts.Insert(0, new StatusPost { Author = "You", Text = newStatusText, Timestamp = DateTime.Now });
            newStatusText = "";
        }
    }

    public class StatusPost
    {
        public string Author { get; set; }
        public string Text { get; set; }
        public DateTime Timestamp { get; set; }
        public string? ImageUrl { get; set; } // Simulated image
    }
}
