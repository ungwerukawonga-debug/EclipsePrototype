@page "/jd/daily-reflections"

<div class="relative z-10 flex flex-col flex-grow">
    <main class="flex-grow flex flex-col items-center justify-start px-6 py-8 mt-16 max-w-4xl mx-auto w-full">
        <!-- Page Header -->
        <div class="w-full text-center md:text-left mb-8">
            <h2 class="font-headline font-black text-4xl text-on-background tracking-tighter leading-none">
                Daily <span class="text-primary-container">Reflections</span>
            </h2>
            <p class="text-on-surface-variant text-lg mt-2">Pause and reflect on your journey.</p>
        </div>

        <!-- New Reflection Section -->
        <div class="w-full glass-effect border border-outline-variant/10 rounded-3xl p-6 mb-6">
            <h3 class="text-on-surface font-headline font-bold text-xl mb-4">New Reflection</h3>
            <textarea @bind="currentReflection" placeholder="What are your thoughts today, Guardian?" class="w-full bg-surface-container-highest border-none rounded-xl py-3 px-4 text-on-surface placeholder:text-outline/50 focus:ring-1 focus:ring-primary-fixed-dim transition-all outline-none h-32"></textarea>
            <button @onclick="SaveReflection" class="mt-4 bg-primary-container hover:bg-primary-fixed-dim text-on-primary font-headline font-extrabold py-3 px-6 rounded-xl shadow-[0_4px_20px_rgba(255,210,63,0.3)] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
                <span class="material-symbols-outlined text-xl">save</span> Save Reflection
            </button>
        </div>

        <!-- Past Reflections Section -->
        <div class="w-full glass-effect border border-outline-variant/10 rounded-3xl p-6">
            <h3 class="text-on-surface font-headline font-bold text-xl mb-4">Past Reflections</h3>
            <div class="flex flex-col gap-4">
                @if (pastReflections.Any())
                {
                    @foreach (var reflection in pastReflections)
                    {
                        <div class="bg-surface-container-highest p-4 rounded-2xl">
                            <p class="text-on-surface-variant text-xs mb-1">@reflection.Date.ToShortDateString()</p>
                            <p class="font-body text-sm text-on-surface">@reflection.Text</p>
                        </div>
                    }
                }
                else
                {
                    <p class="text-on-surface-variant text-sm">No past reflections yet. Start writing!</p>
                }
            </div>
        </div>
    </main>
</div>

@code {
    private string currentReflection = "";
    private List<Reflection> pastReflections = new List<Reflection>
    {
        new Reflection { Date = DateTime.Now.AddDays(-1), Text = "Contemplated the nature of Aetheric flow. Found peace in the patterns." },
        new Reflection { Date = DateTime.Now.AddDays(-3), Text = "Challenged by a new training regimen. Growth requires discomfort." }
    };

    private void SaveReflection()
    {
        if (!string.IsNullOrWhiteSpace(currentReflection))
        {
            pastReflections.Insert(0, new Reflection { Date = DateTime.Now, Text = currentReflection });
            currentReflection = "";
        }
    }

    public class Reflection
    {
        public DateTime Date { get; set; }
        public string Text { get; set; }
    }
}
